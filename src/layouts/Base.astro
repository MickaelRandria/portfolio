---
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** JSON-LD propre à la page, ajouté au graphe commun Person + ProfessionalService. */
  jsonLd?: Record<string, unknown>[]
}

const { title, description, jsonLd = [] } = Astro.props
const site = Astro.site!.href.replace(/\/$/, '')
const canonical = new URL(Astro.url.pathname, Astro.site).href

const NAV = [
  { label: 'Offres', href: '/offres' },
  { label: 'Réalisations', href: '/#realisations' },
  { label: 'Lab IA', href: '/lab' },
  { label: 'Contact', href: '/contact' },
]

// Volontairement sans priceRange : aucun prix n'est affiché sur le site.
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site}/#person`,
      name: 'Mickael Randrianandraina',
      jobTitle: 'Web Analyst',
      url: `${site}/`,
      email: 'mailto:mickarandrianan@gmail.com',
      image: `${site}/photo-mickael.webp`,
      address: { '@type': 'PostalAddress', addressLocality: 'Bordeaux', addressCountry: 'FR' },
      alumniOf: 'Master Data Marketing & IA (RNCP niveau 7)',
      knowsAbout: [
        'Web analytics',
        'Adobe Analytics',
        'Commanders Act',
        'Conformité RGPD et cookies',
        'Looker Studio',
        'React',
        'Node.js',
        'Agents LLM',
      ],
      sameAs: ['https://github.com/MickaelRandria'],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site}/#service`,
      name: 'Mickael Randrianandraina, Web Analyst freelance',
      description:
        'Des sites qui se mesurent : tracking, conformité RGPD et mesure de la performance livrés dedans.',
      url: `${site}/`,
      email: 'mickarandrianan@gmail.com',
      image: `${site}/photo-mickael.webp`,
      founder: { '@id': `${site}/#person` },
      address: { '@type': 'PostalAddress', addressLocality: 'Bordeaux', addressCountry: 'FR' },
      areaServed: [
        { '@type': 'City', name: 'Bordeaux' },
        { '@type': 'Country', name: 'France' },
      ],
    },
    ...jsonLd,
  ],
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0F1B2D" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}/og-image.svg`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600;1,9..144,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!-- Marque la présence de JS avant le premier rendu : sans JS, les blocs
         [data-reveal] restent visibles (jamais de zone morte). -->
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-sand focus:px-4 focus:py-2 focus:text-ink"
    >
      Aller au contenu
    </a>

    <header class="sticky top-0 z-40 border-b border-gold/15 bg-ink/85 backdrop-blur-md">
      <nav
        aria-label="Navigation principale"
        class="mx-auto flex max-w-[1600px] items-center justify-between gap-6 px-5 py-4 sm:px-8 lg:px-16 xl:px-24"
      >
        <a href="/" class="font-fraunces text-xl font-semibold tracking-tight text-sand sm:text-2xl">
          Mickael
        </a>
        <ul class="hidden items-center gap-8 md:flex">
          {
            NAV.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-sand/75 transition-colors hover:text-sand">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href="/contact"
          class="inline-flex min-h-11 items-center rounded-sm border border-gold/60 px-4 text-sm text-sand transition-colors hover:bg-sand hover:text-ink"
        >
          Réserver 30 min
        </a>
      </nav>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="border-t border-gold/15 bg-ink">
      <div class="mx-auto grid max-w-[1600px] gap-10 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:px-16 xl:px-24">
        <div class="lg:col-span-5">
          <p class="font-fraunces text-2xl font-semibold">Mickael Randrianandraina</p>
          <p class="mt-3 text-sm text-sand/70">
            Web Analyst freelance. Des sites qui se mesurent. Bordeaux et remote.
          </p>
        </div>
        <ul class="flex flex-wrap gap-x-8 gap-y-3 text-sm lg:col-span-7 lg:justify-end">
          <li>
            <a href="mailto:mickarandrianan@gmail.com" class="text-sand/80 hover:text-sand">
              mickarandrianan@gmail.com
            </a>
          </li>
          <li>
            <a href="https://github.com/MickaelRandria" class="text-sand/80 hover:text-sand">GitHub</a>
          </li>
          <li><a href="/contact" class="text-sand/80 hover:text-sand">Réserver un créneau</a></li>
        </ul>
        <p class="annot text-sand/50 lg:col-span-12">© {new Date().getFullYear()} · Bordeaux, France</p>
      </div>
    </footer>

    <script>
      // Reveal anticipé : on déclenche quand le bloc arrive à 20 % de viewport
      // sous le bas de l'écran, pour qu'il soit déjà visible à son entrée.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              io.unobserve(entry.target)
            }
          }
        },
        { rootMargin: '0px 0px 20% 0px' },
      )
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el))
    </script>
  </body>
</html>
