---
// Polices auto-hébergées : seuls les sous-ensembles utilisés sont téléchargés
// (unicode-range), sans aller-retour vers Google Fonts.
import '@fontsource-variable/fraunces/opsz.css'
import '@fontsource-variable/fraunces/opsz-italic.css'
import '@fontsource-variable/inter/index.css'
import '@fontsource/jetbrains-mono/latin-400.css'
import '@fontsource/jetbrains-mono/latin-500.css'
import '../styles/global.css'
import { CHANNELS, EMAIL, SAME_AS } from '../lib/site'

interface Props {
  title: string
  description: string
  /** JSON-LD propre à la page, ajouté au graphe commun Person + ProfessionalService. */
  jsonLd?: Record<string, unknown>[]
}

const { title, description, jsonLd = [] } = Astro.props
const site = Astro.site!.href.replace(/\/$/, '')
const canonical = new URL(Astro.url.pathname, Astro.site).href

const NAV = [
  { label: 'Offres', href: '/offres' },
  { label: 'Réalisations', href: '/#realisations' },
  { label: 'Lab IA', href: '/lab' },
  { label: 'Contact', href: '/contact' },
]

// Volontairement sans priceRange : aucun prix n'est affiché sur le site.
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site}/#person`,
      name: 'Mickael Randrianandraina',
      jobTitle: 'Web Analyst',
      url: `${site}/`,
      email: `mailto:${EMAIL}`,
      image: `${site}/photo-mickael.webp`,
      address: { '@type': 'PostalAddress', addressLocality: 'Bordeaux', addressCountry: 'FR' },
      alumniOf: 'Master Data Marketing & IA (RNCP niveau 7)',
      knowsAbout: [
        'Web analytics',
        'Adobe Analytics',
        'Commanders Act',
        'Conformité RGPD et cookies',
        'Looker Studio',
        'React',
        'Node.js',
        'Agents LLM',
      ],
      sameAs: SAME_AS,
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site}/#service`,
      name: 'Mickael Randrianandraina, Web Analyst freelance',
      description:
        'Des sites qui se mesurent : tracking, conformité RGPD et mesure de la performance livrés dedans.',
      url: `${site}/`,
      email: EMAIL,
      image: `${site}/photo-mickael.webp`,
      founder: { '@id': `${site}/#person` },
      address: { '@type': 'PostalAddress', addressLocality: 'Bordeaux', addressCountry: 'FR' },
      areaServed: [
        { '@type': 'City', name: 'Bordeaux' },
        { '@type': 'Country', name: 'France' },
      ],
    },
    ...jsonLd,
  ],
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0F1B2D" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}/og-image.jpg`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mickael Randrianandraina, Web Analyst freelance : Concevoir. Mesurer. Faire grandir." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site}/og-image.jpg`} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!-- Marque la présence de JS avant le premier rendu : sans JS, les blocs
         [data-reveal] restent visibles (jamais de zone morte). -->
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-sand focus:px-4 focus:py-2 focus:text-ink"
    >
      Aller au contenu
    </a>

    <header class="sticky top-0 z-40 border-b border-gold/15 bg-ink/85 backdrop-blur-md">
      <nav
        aria-label="Navigation principale"
        class="mx-auto flex max-w-[1600px] items-center justify-between gap-6 px-5 py-4 sm:px-8 lg:px-16 xl:px-24"
      >
        <a href="/" class="font-fraunces text-xl font-semibold tracking-tight text-sand sm:text-2xl">
          Mickael
        </a>
        <ul class="hidden items-center gap-8 md:flex">
          {
            NAV.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-sand/75 transition-colors hover:text-sand">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href="/contact"
          class="inline-flex min-h-11 items-center rounded-sm border border-gold/60 px-4 text-sm text-sand transition-colors hover:bg-sand hover:text-ink"
        >
          Réserver 30 min
        </a>
      </nav>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="grid-tech border-t border-gold/15 bg-ink">
      <div class="mx-auto grid max-w-[1600px] gap-12 px-5 py-20 sm:px-8 lg:grid-cols-12 lg:px-16 xl:px-24">
        <div class="lg:col-span-5">
          <p class="annot text-gold">Contact</p>
          <p class="font-fraunces mt-4 text-3xl font-bold leading-[1.1] lg:text-4xl">
            Un projet, une question ? <span class="italic text-gold">Écrivez-moi.</span>
          </p>
          <a href={`mailto:${EMAIL}`} class="mt-6 inline-block text-lg text-sand underline decoration-gold/50 underline-offset-4 hover:decoration-gold">
            {EMAIL}
          </a>
          <p class="mt-3 text-sm text-sand/65">Réponse sous 48 h · Bordeaux et remote</p>
        </div>

        <nav aria-label="Canaux de contact" class="lg:col-span-6 lg:col-start-7">
          <p class="annot text-sand/50">Tous les canaux</p>
          <ul class="mt-4 grid grid-cols-1 border-t border-sand/15 sm:grid-cols-2">
            {
              CHANNELS.map((c) => (
                <li class="border-b border-sand/15">
                  {c.href ? (
                    <a
                      href={c.href}
                      {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      class="flex min-h-14 items-center justify-between gap-4 py-3 pr-4 text-sand transition-colors hover:text-gold"
                    >
                      <span class="font-fraunces text-xl">{c.label}</span>
                      <span aria-hidden="true" class="annot text-sand/50">↗</span>
                    </a>
                  ) : (
                    <span class="flex min-h-14 items-center justify-between gap-4 py-3 pr-4 text-sand/45">
                      <span class="font-fraunces text-xl">{c.label}</span>
                      <span class="annot">À venir</span>
                    </span>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex flex-wrap justify-between gap-4 border-t border-sand/15 pt-6 lg:col-span-12">
          <p class="annot text-sand/50">© {new Date().getFullYear()} Mickael Randrianandraina · Bordeaux, France</p>
          <ul class="annot flex flex-wrap gap-x-6 text-sand/50">
            <li><a href="/offres" class="inline-flex min-h-11 items-center hover:text-sand">Offres</a></li>
            <li><a href="/#realisations" class="inline-flex min-h-11 items-center hover:text-sand">Réalisations</a></li>
            <li><a href="/lab" class="inline-flex min-h-11 items-center hover:text-sand">Lab IA</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script>
      // Reveal anticipé : on déclenche quand le bloc arrive à 20 % de viewport
      // sous le bas de l'écran, pour qu'il soit déjà visible à son entrée.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              io.unobserve(entry.target)
            }
          }
        },
        { rootMargin: '0px 0px 20% 0px' },
      )
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el))
    </script>
  </body>
</html>
