---
import Sparkline from './Sparkline.astro'
import { SPEED_CLAIM, SPEED_POINTS } from '../lib/site'

interface Props {
  tone?: 'light' | 'dark'
}

const { tone = 'dark' } = Astro.props
const dark = tone === 'dark'
---

<!-- Argument de vitesse : l'agentique au service du délai, sans rogner la qualité. -->
<div data-reveal class={`rounded-sm border p-7 lg:p-10 ${dark ? 'border-gold/40 bg-ink-2 text-sand' : 'border-ink/20 bg-sand-2/60 text-ink'}`}>
  <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <p class={`annot ${dark ? 'text-gold' : 'text-water'}`}>Workflow agentique</p>
      <h2 class="font-fraunces mt-4 text-3xl font-bold leading-[1.1] lg:text-4xl">
        {SPEED_CLAIM}, <span class={`italic ${dark ? 'text-gold' : ''}`}>sans rogner sur le rendu</span>.
      </h2>
    </div>
    <div class="lg:col-span-4 lg:col-start-9">
      <Sparkline class={`h-12 w-full ${dark ? 'text-gold/70' : 'text-water'}`} />
      <p class={`mt-3 text-sm leading-[1.55] ${dark ? 'text-sand/70' : 'text-ink/70'}`}>
        Méthode éprouvée sur <a href="/agentique-ia/timespeech" class="underline underline-offset-4">TimeSpeech</a> : 10 écrans
        produits par un pipeline de 4 agents.
      </p>
    </div>
  </div>

  <ol class={`mt-10 grid grid-cols-1 border-t md:grid-cols-3 ${dark ? 'border-sand/15' : 'border-ink/15'}`}>
    {
      SPEED_POINTS.map((pt, i) => (
        <li class={`pt-6 md:pr-6 ${i ? `mt-6 border-t pt-6 md:mt-0 md:border-l md:border-t-0 md:pl-6 ${dark ? 'border-sand/15' : 'border-ink/15'}` : ''}`}>
          <span class={`font-mono text-xs ${dark ? 'text-gold' : 'text-water'}`}>{String(i + 1).padStart(2, '0')}</span>
          <h3 class="font-fraunces mt-2 text-xl font-semibold">{pt.title}</h3>
          <p class={`mt-2 text-sm leading-[1.6] ${dark ? 'text-sand/75' : 'text-ink/75'}`}>{pt.text}</p>
        </li>
      ))
    }
  </ol>
</div>
