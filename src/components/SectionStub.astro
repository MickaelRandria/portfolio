---
/**
 * Ossature temporaire d'une section pendant la migration : numéro mono,
 * titre et ce qu'elle doit contenir. Remplacée section par section (étape 6).
 */
interface Props {
  num: string
  title: string
  todo: string
  tone?: 'light' | 'dark'
}

const { num, title, todo, tone = 'dark' } = Astro.props
---

<section
  class={`grid-tech ${tone === 'light' ? 'paper bg-sand text-ink' : 'bg-ink text-sand'}`}
>
  <div class="mx-auto max-w-[1600px] px-5 py-20 sm:px-8 lg:px-16 xl:px-24">
    <p class="annot opacity-60">{num} · À construire</p>
    <h2 class="font-fraunces mt-4 text-3xl font-bold lg:text-4xl">{title}</h2>
    <p class="mt-3 max-w-2xl text-sm opacity-70">{todo}</p>
    <slot />
  </div>
</section>
