---
import { render, type CollectionEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import LazyVideo from './LazyVideo'
import MediaPlaceholder from './MediaPlaceholder'

interface Props {
  project: CollectionEntry<'projects'>
  next: CollectionEntry<'projects'>
}

const { project, next } = Astro.props
const p = project.data
const { Content } = await render(project)
const base = p.section === 'lab' ? '/lab' : '/realisations'
const site = Astro.site!.href.replace(/\/$/, '')

// Vue experte : le public visé fixe le vocabulaire et la mise en forme.
const LENS = {
  agentique: {
    eyebrow: 'Pour les experts IA agentique',
    title: "Sous le capot de l'agent",
    specsLabel: 'agent.config',
    dark: true,
  },
  'data-web': {
    eyebrow: 'Pour les experts web analytics & marketing',
    title: 'Mesure, conformité, référencement',
    specsLabel: 'Fiche de mesure',
    dark: false,
  },
  produit: {
    eyebrow: 'Pour les équipes produit',
    title: 'Les choix produit',
    specsLabel: 'Fiche produit',
    dark: false,
  },
} as const
const lens = LENS[p.lens]

const jsonLd = [
  {
    '@type': 'CreativeWork',
    name: p.title,
    description: p.value,
    dateCreated: p.year,
    creator: { '@id': `${site}/#person` },
    ...(p.liveUrl ? { url: p.liveUrl } : {}),
  },
]
---

<Base title={`${p.title} · ${p.typology} | Mickael Randrianandraina`} description={p.value} jsonLd={jsonLd}>
  <article class="bg-ink text-sand">
    <div class="mx-auto max-w-[1280px] px-5 pb-24 pt-16 sm:px-8 lg:pt-24">
      <!-- 1. Titre + typologie + client + année -->
      <header>
        <p class="annot text-gold">{p.typology} · {p.client} · {p.year}</p>
        {p.status && <p class="annot mt-2 text-sand/60">{p.status}</p>}
        <h1
          class="font-fraunces mt-6 font-bold leading-[1.02] tracking-tight"
          style="font-size: clamp(2.5rem, 7vw, 6rem)"
        >
          {p.title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-[1.6] text-sand/75">{p.value}</p>
      </header>

      <!-- 2. Visuel pleine largeur -->
      <div class="crop mt-14">
        {
          p.video ? (
            <LazyVideo
              client:visible
              src={p.video}
              label={`Aperçu vidéo du projet ${p.title}`}
              className="block aspect-[16/10] w-full rounded-sm object-cover"
            />
          ) : (
            <MediaPlaceholder title={p.title} className="aspect-[16/10] rounded-sm" />
          )
        }
      </div>

      <!-- 3. Contexte -->
      <section data-reveal class="mt-24 grid gap-6 lg:grid-cols-12">
        <h2 class="annot text-gold lg:col-span-3">01 · Contexte</h2>
        <p class="font-fraunces text-2xl leading-[1.35] lg:col-span-9 lg:text-3xl">{p.context}</p>
      </section>

      <!-- 4. Ce que j'ai fait (corps MDX) -->
      <section data-reveal class="mt-24 grid gap-6 lg:grid-cols-12">
        <h2 class="annot text-gold lg:col-span-3">02 · Ce que j'ai fait</h2>
        <div
          class="case-body grid gap-10 sm:grid-cols-2 lg:col-span-9 [&_code]:font-mono [&_code]:text-gold [&_h3]:font-fraunces [&_h3]:text-xl [&_h3]:font-semibold [&_p]:mt-2 [&_p]:leading-[1.65] [&_p]:text-sand/75"
        >
          <Content />
        </div>
      </section>

    </div>

    <!-- 4 bis. Vue experte, propre au public du projet -->
    <section
      aria-labelledby="vue-experte"
      class={lens.dark ? 'grid-tech border-y border-gold/15 bg-ink-2 text-sand' : 'paper bg-sand text-ink'}
    >
      <div class="mx-auto max-w-[1280px] px-5 py-20 sm:px-8 lg:py-24">
        <div data-reveal class="grid gap-6 lg:grid-cols-12">
          <p class={`annot lg:col-span-3 ${lens.dark ? 'text-gold' : 'text-water'}`}>03 · {lens.eyebrow}</p>
          <h2 id="vue-experte" class="font-fraunces text-4xl font-bold leading-[1.05] lg:col-span-9 lg:text-5xl">
            {lens.title}
          </h2>
        </div>

        <div class="mt-12 grid gap-10 lg:grid-cols-12">
          {
            lens.dark ? (
              <figure data-reveal class="overflow-hidden rounded-sm border border-gold/25 bg-ink lg:col-span-7">
                <figcaption class="flex items-center gap-2 border-b border-gold/15 px-4 py-3 font-mono text-xs text-sand/60">
                  <span class="h-2 w-2 rounded-full bg-sand/25" aria-hidden="true" />
                  <span class="h-2 w-2 rounded-full bg-sand/25" aria-hidden="true" />
                  <span class="h-2 w-2 rounded-full bg-sand/25" aria-hidden="true" />
                  <span class="ml-2">{lens.specsLabel}</span>
                </figcaption>
                <dl class="divide-y divide-gold/10 font-mono text-[13px]">
                  {p.specs.map((s) => (
                    <div class="grid gap-1 px-5 py-3.5 sm:grid-cols-[11rem_1fr] sm:gap-4">
                      <dt class="text-gold">{s.label}</dt>
                      <dd class="leading-[1.6] text-sand/85">{s.value}</dd>
                    </div>
                  ))}
                </dl>
              </figure>
            ) : (
              <div data-reveal class="lg:col-span-7">
                <p class="annot text-ink/60">{lens.specsLabel}</p>
                <table class="mt-4 w-full border-t border-ink/25 text-left text-sm">
                  <tbody>
                    {p.specs.map((s) => (
                      <tr class="border-b border-ink/15 align-top">
                        <th scope="row" class="w-44 py-3.5 pr-4 font-mono text-xs font-normal uppercase text-water">
                          {s.label}
                        </th>
                        <td class="py-3.5 leading-[1.6] text-ink/85">{s.value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )
          }

          <div class="space-y-8 lg:col-span-5">
            {
              p.deepDive.map((d) => (
                <article data-reveal>
                  <h3 class="font-fraunces text-xl font-semibold">{d.title}</h3>
                  <p class={`mt-2 leading-[1.65] ${lens.dark ? 'text-sand/75' : 'text-ink/75'}`}>{d.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-[1280px] px-5 pb-24 sm:px-8">
      <!-- 5. Résultat chiffré -->
      <section data-reveal class="mt-24 grid gap-6 border-t border-gold/20 pt-12 lg:grid-cols-12">
        <h2 class="annot text-gold lg:col-span-3">04 · Résultat</h2>
        <div class="lg:col-span-9">
          <p class="font-mono text-xl leading-[1.5] text-gold lg:text-2xl">{p.metric}</p>
          <p class="mt-6 max-w-3xl leading-[1.7] text-sand/80">{p.result}</p>
        </div>
      </section>

      <!-- 6. Stack technique -->
      <section data-reveal class="mt-24 grid gap-6 lg:grid-cols-12">
        <h2 class="annot text-gold lg:col-span-3">05 · Stack</h2>
        <ul class="flex flex-wrap gap-2 lg:col-span-9">
          {p.stack.map((tech) => <li class="rounded-sm border border-sand/25 px-3 py-1.5 font-mono text-xs">{tech}</li>)}
        </ul>
      </section>

      <!-- 7. CTA : site live + projet suivant -->
      <nav aria-label="Suite" class="mt-24 grid gap-6 border-t border-gold/20 pt-12 sm:grid-cols-2">
        <div class="flex flex-wrap gap-3">
          {
            p.liveUrl && (
              <a
                href={p.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-12 items-center rounded-sm bg-sand px-7 font-medium text-ink"
              >
                Voir le site live
              </a>
            )
          }
          {
            p.githubUrl && (
              <a
                href={p.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-12 items-center rounded-sm border border-sand/40 px-7"
              >
                Code sur GitHub
              </a>
            )
          }
        </div>
        <a href={`${base}/${next.id}`} class="group sm:text-right">
          <span class="annot text-sand/50">Projet suivant →</span>
          <span class="font-fraunces mt-2 block text-2xl font-semibold group-hover:text-gold">{next.data.title}</span>
        </a>
      </nav>
    </div>
  </article>
</Base>
