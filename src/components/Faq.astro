---
import { PRICE_NOTE, RANGE_NOTE, offer } from '../lib/site'

interface Props {
  tone?: 'light' | 'dark'
}

const { tone = 'dark' } = Astro.props

// Les 4 objections du brief. Réponses alignées sur les offres et délais fournis.
// À VALIDER : « Qui écrit le contenu » et « Après la livraison » décrivent un
// fonctionnement par défaut, à ajuster selon tes conditions.
const QUESTIONS = [
  {
    q: 'Quel budget prévoir ?',
    a: `${PRICE_NOTE} ${RANGE_NOTE} Cochez la case dans le formulaire de contact pour les recevoir avant même d'échanger ; le devis détaillé par livrable suit le cadrage, sans engagement.`,
  },
  {
    q: 'Combien de temps ça prend ?',
    a: `Prototype d'agent IA : ${offer('agent-ia').delay.split(',')[0].replace('Prototype testable ', '')}. Site mesuré : ${offer('site-mesure').delay.split(',')[0]}. Audit : ${offer('audit-tracking').delay.split(',')[0].replace('Audit ', '')}. Des agents IA produisent en pipeline pendant que je garde la conception et la revue : près de 2 fois plus rapide qu'un développement classique. Délai indicatif, confirmé après le cadrage.`,
  },
  {
    q: 'Qui écrit le contenu du site ?',
    a: 'Vous apportez la matière : votre offre, vos références, vos visuels. Je la structure et la mets en forme pour le web et le référencement ; la rédaction complète se définit au cadrage.',
  },
  {
    q: 'Et après la livraison ?',
    a: 'Le site part avec son plan de taggage documenté et son dashboard de suivi : vous savez ce qui est mesuré et comment le lire. Un accompagnement sur les itérations peut se prévoir dès le devis.',
  },
]

const border = tone === 'dark' ? 'border-sand/15' : 'border-ink/15'
const muted = tone === 'dark' ? 'text-sand/75' : 'text-ink/75'
---

<div class={`border-t ${border}`}>
  {
    QUESTIONS.map((item) => (
      <details class={`group border-b ${border}`}>
        <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
          <span class="font-fraunces text-xl font-semibold lg:text-2xl">{item.q}</span>
          <span class="font-mono text-lg transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class={`max-w-3xl pb-6 leading-[1.65] ${muted}`}>{item.a}</p>
      </details>
    ))
  }
</div>
