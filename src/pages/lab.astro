---
import Base from '../layouts/Base.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { getSection } from '../lib/projects'

const lab = await getSection('lab')
---

<Base
  title="Lab IA · Agents et automatisations | Mickael Randrianandraina"
  description="Agents LLM et automatisations qui transforment la donnée en décision : Baromètre Data, Beastly Creator Portal, TimeSpeech."
>
  <section class="grid-tech bg-ink text-sand">
    <div class="mx-auto max-w-[1600px] px-5 py-20 sm:px-8 lg:px-16 lg:py-28 xl:px-24">
      <p class="annot text-gold">Lab IA &amp; Data</p>
      <h1 class="font-fraunces mt-4 font-bold leading-[1.02] tracking-tight" style="font-size: clamp(2.5rem, 7vw, 6rem)">
        Des agents qui <span class="italic text-gold">décident</span>.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-[1.6] text-sand/75">
        IA agentique, LLM et données live. Chaque projet affiche son niveau de maturité réel.
      </p>
      <div class="mt-12">
        {lab.map((project) => <ProjectCard project={project} tone="dark" />)}
      </div>
    </div>
  </section>
</Base>
