---
import Base from '../layouts/Base.astro'
import ProjectCard from '../components/ProjectCard.astro'
import Hero from '../components/home/Hero.astro'
import TrustBand from '../components/home/TrustBand.astro'
import Offers from '../components/home/Offers.astro'
import ProofBand from '../components/home/ProofBand.astro'
import Method from '../components/home/Method.astro'
import Testimonials from '../components/home/Testimonials.astro'
import About from '../components/home/About.astro'
import AuditFaq from '../components/home/AuditFaq.astro'
import { getSection } from '../lib/projects'

const realisations = await getSection('realisations')
const lab = (await getSection('lab')).slice(0, 2)
---

<Base
  title="Mickael Randrianandraina · Web Analyst freelance, Bordeaux"
  description="Des sites qui se mesurent. Tracking, conformité RGPD et mesure de la performance livrés dedans. Bordeaux et remote."
>
  <Hero />
  <TrustBand />
  <Offers />
  <ProofBand />

  <section id="realisations" class="paper bg-sand text-ink">
    <div class="mx-auto max-w-[1600px] px-5 py-20 sm:px-8 lg:px-16 lg:py-24 xl:px-24">
      <div data-reveal class="grid gap-6 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="annot text-water">04 · Réalisations</p>
          <h2 class="font-fraunces mt-5 font-bold leading-[1.02] tracking-tight" style="font-size: clamp(2.25rem, 5.5vw, 4.75rem)">
            Des projets, <span class="italic">un chiffre chacun</span>.
          </h2>
        </div>
        <p class="text-lg leading-[1.6] text-ink/75 lg:col-span-4 lg:col-start-9 lg:self-end">
          Conformité et SEO local, feature produit, catalogue connecté : chaque projet est
          présenté avec ce qu'il a réellement livré.
        </p>
      </div>
      <div class="mt-12">
        {realisations.map((project, i) => <ProjectCard project={project} tone="light" index={i + 1} />)}
      </div>
    </div>
  </section>

  <section id="lab" class="bg-ink text-sand">
    <div class="mx-auto max-w-[1600px] px-5 py-20 sm:px-8 lg:px-16 lg:py-20 xl:px-24">
      <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="annot text-gold">05 · Lab IA</p>
          <h2 class="font-fraunces mt-4 text-4xl font-bold leading-[1.05] tracking-tight lg:text-5xl">
            Des agents qui <span class="italic text-gold">décident</span>.
          </h2>
        </div>
        <a href="/lab" class="annot inline-flex min-h-11 items-center text-sand underline decoration-gold/50 underline-offset-4 hover:decoration-gold">
          Tout le Lab IA →
        </a>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-x-10 gap-y-4 md:grid-cols-2">
        {lab.map((project) => <ProjectCard project={project} tone="dark" layout="stacked" />)}
      </div>
    </div>
  </section>

  <Method />
  <Testimonials />
  <About />
  <AuditFaq />
</Base>
