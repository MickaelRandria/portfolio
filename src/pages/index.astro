---
import Base from '../layouts/Base.astro'
import ProjectCard from '../components/ProjectCard.astro'
import SectionStub from '../components/SectionStub.astro'
import { getSection } from '../lib/projects'

const realisations = await getSection('realisations')
const lab = (await getSection('lab')).slice(0, 2)
---

<Base
  title="Mickael Randrianandraina · Web Analyst freelance, Bordeaux"
  description="Des sites qui se mesurent. Tracking, conformité RGPD et mesure de la performance livrés dedans. Bordeaux et remote."
>
  <SectionStub
    num="01"
    title="Concevoir. Mesurer. Faire grandir."
    todo="Hero plein écran : pitch, 3 chiffres (6 projets livrés, 6,4 M de visites analysées, 3 ans en web analytics), disponibilité, Bordeaux + remote, CTA « Voir les réalisations » / « Réserver 30 min »."
  >
    <h1 class="sr-only">Mickael Randrianandraina, Web Analyst freelance à Bordeaux</h1>
  </SectionStub>
  <SectionStub
    num="02"
    title="Bandeau de confiance"
    todo="Cultura et La Poste (en poste), PrestigeRent, Petite Maille, Beastly (en mission). Noms en texte en attendant les fichiers logos."
    tone="light"
  />
  <SectionStub num="03" title="Ce que je fais" todo="Les 3 offres : pour qui, ce que le client repart avec, délai indicatif, lien vers /offres. Pas de prix." />

  <section id="realisations" class="paper bg-sand text-ink">
    <div class="mx-auto max-w-[1600px] px-5 py-20 sm:px-8 lg:px-16 xl:px-24">
      <p class="annot text-ink/60">04 · Réalisations</p>
      <h2 class="font-fraunces mt-4 text-4xl font-bold lg:text-5xl">Réalisations</h2>
      <div class="mt-10">
        {realisations.map((project) => <ProjectCard project={project} tone="light" />)}
      </div>
    </div>
  </section>

  <section class="bg-ink text-sand">
    <div class="mx-auto max-w-[1600px] px-5 py-20 sm:px-8 lg:px-16 xl:px-24">
      <p class="annot text-gold">05 · Lab IA</p>
      <h2 class="font-fraunces mt-4 text-4xl font-bold lg:text-5xl">Des agents qui <span class="italic text-gold">décident</span>.</h2>
      <div class="mt-10">
        {lab.map((project) => <ProjectCard project={project} tone="dark" />)}
      </div>
      <a href="/lab" class="mt-6 inline-flex min-h-11 items-center text-sm underline underline-offset-4">Tout le Lab IA</a>
    </div>
  </section>

  <SectionStub num="06" title="Méthode en 3 temps" todo="Concevoir / Mesurer / Faire grandir, en bande horizontale compacte." tone="light" />
  <SectionStub
    num="07"
    title="Témoignages"
    todo="Composant prêt, 2 citations courtes (nom + activité). Emplacement explicite tant que les témoignages ne sont pas fournis, jamais de faux témoignage."
  />
  <SectionStub
    num="08"
    title="À propos"
    todo="Photo + 4 lignes + « En ce moment » : Freelance à temps plein, Web Analyst chez Cultura (oct. 2024 à oct. 2026), Master Data Marketing & IA obtenu en 2026."
    tone="light"
  />
  <SectionStub num="09" title="Audit offert + FAQ" todo="Bloc audit 30 min existant + 4 questions : budget, délai, qui écrit le contenu, après la livraison." />
</Base>
