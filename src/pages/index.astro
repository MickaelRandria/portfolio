---
import Base from '../layouts/Base.astro'
import ProjectCard from '../components/ProjectCard.astro'
import Hero from '../components/home/Hero.astro'
import TrustBand from '../components/home/TrustBand.astro'
import Offers from '../components/home/Offers.astro'
import ProofBand from '../components/home/ProofBand.astro'
import Method from '../components/home/Method.astro'
import Testimonials from '../components/home/Testimonials.astro'
import About from '../components/home/About.astro'
import AuditFaq from '../components/home/AuditFaq.astro'
import { getSection } from '../lib/projects'

const realisations = await getSection('realisations')
// L'agentique IA ouvre la home : le projet vedette en grand, les deux autres côte à côte.
const [featured, ...agents] = await getSection('agentique')
---

<Base
  title="Mickael Randrianandraina · Agentique IA & web analytics, Bordeaux"
  description="Agentique IA : des agents qui transforment la donnée en décisions. Et des sites qui se mesurent, tracking et conformité RGPD livrés dedans. Bordeaux et remote."
>
  <Hero />
  <TrustBand />

  <section id="agentique" class="grid-tech bg-ink text-sand">
    <div class="mx-auto max-w-[1600px] px-5 py-20 sm:px-8 lg:px-16 lg:py-24 xl:px-24">
      <div data-reveal class="grid gap-6 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="annot text-gold">03 · Agentique IA</p>
          <h2 class="font-fraunces mt-5 font-bold leading-[1.02] tracking-tight" style="font-size: clamp(2.25rem, 5.5vw, 4.75rem)">
            Des agents qui <span class="italic text-gold">décident</span>.
          </h2>
        </div>
        <div class="lg:col-span-4 lg:col-start-9 lg:self-end">
          <p class="text-lg leading-[1.6] text-sand/75">
            Agents LLM, données live et garde-fous : des outils qui enchaînent des décisions et
            disent ce qu'ils savent vraiment. Chaque démo se teste en ligne.
          </p>
          <a href="/agentique-ia" class="annot mt-5 inline-flex min-h-11 items-center text-sand underline decoration-gold/50 underline-offset-4 hover:decoration-gold">
            Toute l'agentique IA →
          </a>
        </div>
      </div>
      <div class="mt-12">
        <ProjectCard project={featured} tone="dark" index={1} />
      </div>
      <div class="grid grid-cols-1 gap-x-10 gap-y-4 md:grid-cols-2">
        {agents.map((project, i) => <ProjectCard project={project} tone="dark" layout="stacked" index={i + 2} />)}
      </div>
    </div>
  </section>

  <Offers />
  <ProofBand />

  <section id="realisations" class="paper bg-sand text-ink">
    <div class="mx-auto max-w-[1600px] px-5 py-20 sm:px-8 lg:px-16 lg:py-24 xl:px-24">
      <div data-reveal class="grid gap-6 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="annot text-water">05 · Réalisations</p>
          <h2 class="font-fraunces mt-5 font-bold leading-[1.02] tracking-tight" style="font-size: clamp(2.25rem, 5.5vw, 4.75rem)">
            Des sites, <span class="italic">un chiffre chacun</span>.
          </h2>
        </div>
        <p class="text-lg leading-[1.6] text-ink/75 lg:col-span-4 lg:col-start-9 lg:self-end">
          Conformité et SEO local, feature produit, catalogue connecté : chaque projet est
          présenté avec ce qu'il a réellement livré.
        </p>
      </div>
      <div class="mt-12">
        {realisations.map((project, i) => <ProjectCard project={project} tone="light" index={i + 1} />)}
      </div>
    </div>
  </section>

  <Method />
  <Testimonials />
  <About />
  <AuditFaq />
</Base>
